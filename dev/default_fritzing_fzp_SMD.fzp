<?xml version='1.0' encoding='UTF-8'?>
<module moduleId="moduleId" referenceFile="anything.fzp" fritzingVersion="1.0.5">
 <version>3</version>
 <author>Your Name (username if applicable)</author>
 <title>Part Name</title>
 <label>A</label>
 <date>DAY MMM D YYYY</date>
 <tags>
  <tag>adafruit</tag>
  <tag>contrib</tag>
  <tag>fritzing user</tag>
  <tag>I2C</tag>
 </tags>
 <properties>
  <property name="family">family</property>
  <property name="variant">variant</property>
  <!--Very important! Compulsory to fill in something!-->
  <property name="layer"></property>
  <property name="mpn"></property>
  <property name="mn"></property>
  <property name="part number"></property>
  <!--Needed for Pick & Place-->
 </properties>
 <description>&lt;html>

&lt;p>This is a html-supported descrption box. It has &lt;strong>bold&lt;/strong>, and &lt;em>italic&lt;/em>(&lt;a href="https://www.adafruit.com/">A link to Adafruit's Website!&lt;/a>)&lt;/p>

&lt;ul>
&lt;li>Tags &amp; and amps here need to be escaped! Caution!&lt;/li>
&lt;li>Try not to have styles here, so don't just copy and paste things from the web here using the New Part Editor!&lt;/li>
&lt;/ul>

&lt;/html></description>
 <views>
  <iconView>
   <layers image="icon/moduleId.svg">
    <layer layerId="icon"/>
    <!--Replace "icon" with "breadboard" to reuse breadboard image-->
   </layers>
  </iconView>
  <breadboardView>
   <layers image="breadboard/moduleId.svg">
    <layer layerId="breadboard"/>
   </layers>
  </breadboardView>
  <schematicView>
   <layers image="schematic/moduleId.svg">
    <layer layerId="schematic"/>
   </layers>
  </schematicView>
  <pcbView>
   <layers image="pcb/moduleId.svg">
    <layer layerId="silkscreen"/>
    <!--No copper0 definition!-->
    <layer layerId="copper1"/>
   </layers>
  </pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="GND" type="male">
   <description>pin 1</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector0pin" terminalId="connector0terminal"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector0pin"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector1" name="VCC" type="male">
   <description>pin 2</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector1pin" terminalId="connector1terminal"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector1pin"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector2" name="SDA" type="male">
   <description>pin 3</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector2pin" terminalId="connector2terminal"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector2pin"/>
    </pcbView>
   </views>
  </connector>
  <connector id="connector3" name="SCL" type="male">
   <description>pin 4</description>
   <views>
    <breadboardView>
     <p layer="breadboard" svgId="connector3pin" terminalId="connector3terminal"/>
    </breadboardView>
    <schematicView>
     <p layer="schematic" svgId="connector3pin" terminalId="connector3terminal"/>
    </schematicView>
    <pcbView>
     <p layer="copper1" svgId="connector3pin"/>
    </pcbView>
   </views>
  </connector>
 </connectors>
 <url>https://www.adafruit.com/product/1000</url>
</module>